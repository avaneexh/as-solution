NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Required for guest lead intake.
SUPABASE_SERVICE_ROLE_KEY=
# Set true on the public deployment after setting up Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_TURNSTILE=false
# Required in production: random secret for hashing abuse-control identifiers.
RATE_LIMIT_SALT=
# Meta WhatsApp Cloud API (optional; website guided chat works without this).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Choose the supported Graph API version shown in your Meta app dashboard (e.g. v24.0).
WHATSAPP_API_VERSION=
